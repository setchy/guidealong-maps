{
  "name": "guidealong-maps",
  "version": "1.0.0",
  "description": "A simple site that helps you explore GuideAlong tour locations across the globe.",
  "private": true,
  "scripts": {
    "start": "vite",
    "lint": "biome check --fix",
    "fetch:tours": "node ./lib/index.js",
    "test": "node --test"
  },
  "author": {
    "name": "Adam Setch",
    "url": "https://github.com/setchy"
  },
  "homepage": "https://tours.setchy.io",
  "bugs": {
    "url": "https://github.com/setchy/guidealong-maps/issues"
  },
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@googlemaps/google-maps-services-js": "3.4.2",
    "cheerio": "1.2.0",
    "dotenv": "18.0.9",
    "picocolors": "1.1.1",
    "playwright-core": "1.64.1",
    "vite": "8.3.5"
  }
}
