{
  "name": "guidealong-maps",
  "version": "1.0.0",
  "description": "A simple site that helps you explore GuideAlong tour locations across the globe.",
  "private": true,
  "scripts": {
    "start": "vite",
    "lint": "biome lint --fix .",
    "lint:check": "biome lint .",
    "lint:ci": "biome ci --reporter=github",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "links:check": "lychee --offline \"src/**/*.html\"",
    "links:check:external": "lychee \"src/**/*.html\"",
    "fetch:tours": "node ./lib/index.js",
    "test": "node --test"
  },
  "author": {
    "name": "Adam Setch",
    "url": "https://github.com/setchy"
  },
  "homepage": "https://tours.setchy.io",
  "bugs": {
    "url": "https://github.com/setchy/guidealong-maps/issues"
  },
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@googlemaps/google-maps-services-js": "3.4.2",
    "cheerio": "1.2.0",
    "dotenv": "18.0.9",
    "picocolors": "1.1.1",
    "playwright-core": "1.65.0",
    "vite": "8.3.5"
  }
}
